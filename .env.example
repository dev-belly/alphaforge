# ---------------------------------------------------------------------------
# AlphaForge environment template.
#
# Copy to `.env` and fill in only what you need. `.env` is git-ignored; never
# commit real credentials. AlphaForge runs end-to-end with NONE of these set -
# the `sample` provider needs no network and no token.
# ---------------------------------------------------------------------------

# --- Logging ---------------------------------------------------------------
ALPHAFORGE_LOG_LEVEL=INFO
# ALPHAFORGE_LOG_JSON=false

# --- Data providers (all optional) -----------------------------------------
# `sample` (default, synthetic, offline) | `local` | `yahoo` | `akshare` | `tushare`
ALPHAFORGE_DATA_PROVIDER=sample

# Only required by the vendor adapters that need a credential. Leave blank to
# keep the adapter disabled.
# TUSHARE_TOKEN=
# ALPHA_VANTAGE_API_KEY=

# --- Optional LLM Research Copilot -----------------------------------------
# The copilot is OPTIONAL. With provider=none it degrades to a deterministic,
# rule-based analyst that reads the same real tool outputs - no fabrication,
# no network, no key required.
ALPHAFORGE_AGENT_PROVIDER=none
# ALPHAFORGE_AGENT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ALPHAFORGE_AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Service ports ---------------------------------------------------------
ALPHAFORGE_API_PORT=8000
ALPHAFORGE_DASHBOARD_PORT=8501
